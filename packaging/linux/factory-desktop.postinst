#!/usr/bin/env bash
set -euo pipefail

APP_ROOT=/opt/Factory
SANDBOX="$APP_ROOT/chrome-sandbox"
if [[ -f "$SANDBOX" ]]; then
  chown root:root "$SANDBOX"
  chmod 4755 "$SANDBOX"
fi

update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
install -d -m 0700 /var/cache/factory-update-manager/packages /var/lib/factory-update-manager/known-good
USER_SERVICES=(factory-update-manager.service factory-droid-daemon.service)
systemctl --global enable "${USER_SERVICES[@]}" >/dev/null 2>&1 || true
for runtime in /run/user/[0-9]*; do
  [[ -d "$runtime" && -S "$runtime/bus" ]] || continue
  uid="${runtime##*/}"
  user=$(getent passwd "$uid" | cut -d: -f1 || true)
  [[ -n "$user" ]] || continue
  user_env=(env XDG_RUNTIME_DIR="$runtime" DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus")
  runuser -u "$user" -- "${user_env[@]}" systemctl --user daemon-reload >/dev/null 2>&1 || true
  runuser -u "$user" -- "${user_env[@]}" systemctl --user enable --now "${USER_SERVICES[@]}" >/dev/null 2>&1 || true
done
if command -v xdg-mime >/dev/null 2>&1 && [[ -n "${SUDO_USER:-}" ]]; then
  user_home=$(getent passwd "$SUDO_USER" | cut -d: -f6 || true)
  if [[ -n "$user_home" ]]; then
    runuser -u "$SUDO_USER" -- env HOME="$user_home" xdg-mime default factory-desktop.desktop x-scheme-handler/factory-desktop >/dev/null 2>&1 || true
  fi
fi
