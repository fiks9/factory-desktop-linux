#!/usr/bin/env bash
set -euo pipefail

APPDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export FACTORY_DISABLE_KEYRING=1

# AppImage never adopts a system native-package updater.
export FACTORY_UPDATE_MANAGER_UNAVAILABLE=1

if [[ "${1:-}" == --install-desktop-integration ]]; then
  appimage_path="${APPIMAGE:-}"
  if [[ -z "$appimage_path" ]]; then
    printf '%s\n' 'Desktop integration requires running the AppImage file.' >&2
    exit 2
  fi
  applications="$HOME/.local/share/applications"
  mkdir -p "$applications"
  sed "s|^Exec=.*|Exec=env FACTORY_DISABLE_KEYRING=1 FACTORY_UPDATE_MANAGER_UNAVAILABLE=1 $appimage_path %U|" \
    "$APPDIR/factory-desktop.desktop" > "$applications/factory-desktop.desktop"
  update-desktop-database "$applications" >/dev/null 2>&1 || true
  xdg-mime default factory-desktop.desktop x-scheme-handler/factory-desktop >/dev/null 2>&1 || true
  exit 0
fi

exec "$APPDIR/usr/lib/factory-desktop/factory-desktop" "$@"
